---
// Photo grid with category filters and a lightbox. Data: src/data/gallery.json (npm run assets).
// The client script lives in a component, not in pages/gallery.astro: a script tag directly
// in a page breaks the build on Windows when the project path is 'c:\...' (lower-case drive).
import { Image, getImage } from 'astro:assets';
import galleryOld from '../data/gallery.json';
import galleryNew from '../data/gallery-new.json';
import { wp } from '../lib/images';
// New photos from the owner first (better quality), then the photos from the old WP gallery.
// gallery.json is regenerated by npm run assets; gallery-new.json is edited by hand.
const gallery = [...galleryNew, ...galleryOld];
const cats = [...new Set(gallery.map((g) => g.category).filter(Boolean))];
// Lightbox version: one large webp per photo, loaded only when opened
const items = await Promise.all(
  gallery.map(async (g) => {
    const meta = wp(g.src);
    const full = await getImage({ src: meta, width: Math.min(1600, meta.width), format: 'webp' });
    return { ...g, meta, full: full.src };
  })
);
---
{cats.length > 1 && (
  <div class="filters" role="group" aria-label="Filter photos">
    <button type="button" data-filter="" aria-pressed="true">All</button>
    {cats.map((c) => <button type="button" data-filter={c} aria-pressed="false" style="text-transform:capitalize">{c}</button>)}
  </div>
)}
<div class="gal">
  {items.map((g, i) => (
    <button type="button" data-cat={g.category} data-full={g.full} aria-label={`Enlarge: ${g.alt}`}>
      <Image src={g.meta} alt={g.alt} widths={[400, 700]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 360px" loading={i < 6 ? 'eager' : 'lazy'} />
    </button>
  ))}
</div>
<dialog class="lightbox" id="lightbox" aria-label="Enlarged photo"><img alt="" /></dialog>
<script>
  const items = document.querySelectorAll<HTMLButtonElement>('.gal button');
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const big = dlg.querySelector('img')!;
  items.forEach((b) =>
    b.addEventListener('click', () => {
      big.src = b.dataset.full!;
      big.alt = b.querySelector('img')?.alt ?? '';
      dlg.showModal();
    })
  );
  dlg.addEventListener('click', () => dlg.close());
  document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((f) =>
    f.addEventListener('click', () => {
      document.querySelectorAll('.filters button').forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      items.forEach((b) => (b.hidden = !!f.dataset.filter && b.dataset.cat !== f.dataset.filter));
    })
  );
</script>
