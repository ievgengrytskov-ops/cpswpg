---
// Photo grid with category filters, a text block per category and a lightbox.
// Data: src/data/gallery-new.json (by hand, first) + gallery.json (old WP gallery);
// category texts: src/data/gallery-intros.ts. Deep links: /gallery/#kitchen, #bathroom, #refinishing.
import { Image, getImage } from 'astro:assets';
import galleryOld from '../data/gallery.json';
import galleryNew from '../data/gallery-new.json';
import { galleryIntros } from '../data/gallery-intros';
import { wp } from '../lib/images';

const gallery = [...galleryNew, ...galleryOld];
const order = ['bathroom', 'kitchen', 'bathtub refinishing'];
const cats = [...new Set(gallery.map((g) => g.category).filter(Boolean))]
  .sort((a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99));
const count = (c: string) => gallery.filter((g) => g.category === c).length;
// Lightbox version: one large webp per photo, loaded only when opened
const items = await Promise.all(
  gallery.map(async (g) => {
    const meta = wp(g.src);
    const full = await getImage({ src: meta, width: Math.min(1600, meta.width), format: 'webp' });
    return { ...g, meta, full: full.src };
  })
);
---
{cats.length > 1 && (
  <div class="filters" role="group" aria-label="Filter photos">
    <button type="button" data-filter="" aria-pressed="true">All <span>{gallery.length}</span></button>
    {cats.map((c) => (
      <button type="button" data-filter={c} data-hash={galleryIntros[c]?.hash ?? ''} aria-pressed="false">
        {galleryIntros[c]?.label ?? c.charAt(0).toUpperCase() + c.slice(1)} <span>{count(c)}</span>
      </button>
    ))}
  </div>
)}

{Object.entries(galleryIntros).filter(([c]) => cats.includes(c)).map(([c, t]) => (
  <section class="gal-intro" data-intro={c} id={t.hash} hidden aria-labelledby={`gi-${t.hash}`}>
    <div class="gal-intro-main">
      <span class="eyebrow">{t.label} projects</span>
      <h2 id={`gi-${t.hash}`}>{t.title[0]} <em>{t.title[1]}</em></h2>
      <p class="gal-intro-lead">{t.lead}</p>
      {t.text.map((p) => <p class="muted">{p}</p>)}
      <div class="gal-intro-cta">
        <p class="gal-intro-ask">{t.cta}</p>
        <div class="ctas">
          <a class="btn" href="#contacts">Get a free estimate</a>
          {t.links.map((l) => <a class="link-arrow" href={l.href}>{l.label}</a>)}
        </div>
        <p class="gal-intro-tag">{t.tagline}</p>
      </div>
    </div>
    <div class="gal-intro-side">
      <h3>{t.servicesTitle}</h3>
      <ul class="gal-checks">{t.services.map((s) => <li>{s}</li>)}</ul>
      <h3>{t.whyTitle}</h3>
      <ul class="gal-checks gal-checks--why">{t.why.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>
))}

<div class="gal">
  {items.map((g, i) => (
    <button type="button" data-cat={g.category} data-full={g.full} aria-label={`Enlarge: ${g.alt}`}>
      <Image src={g.meta} alt={g.alt} widths={[400, 700]} sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 360px" loading={i < 6 ? 'eager' : 'lazy'} />
    </button>
  ))}
</div>
<dialog class="lightbox" id="lightbox" aria-label="Enlarged photo"><img alt="" /></dialog>
<script>
  const items = document.querySelectorAll<HTMLButtonElement>('.gal button');
  const filters = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const intros = document.querySelectorAll<HTMLElement>('.gal-intro');
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const big = dlg.querySelector('img')!;
  items.forEach((b) =>
    b.addEventListener('click', () => {
      big.src = b.dataset.full!;
      big.alt = b.querySelector('img')?.alt ?? '';
      dlg.showModal();
    })
  );
  dlg.addEventListener('click', () => dlg.close());

  const select = (f: HTMLButtonElement, updateHash: boolean) => {
    const cat = f.dataset.filter ?? '';
    filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
    items.forEach((b) => (b.hidden = !!cat && b.dataset.cat !== cat));
    intros.forEach((s) => (s.hidden = s.dataset.intro !== cat));
    if (updateHash) history.replaceState(null, '', f.dataset.hash ? `#${f.dataset.hash}` : location.pathname);
  };
  filters.forEach((f) => f.addEventListener('click', () => select(f, true)));

  // open /gallery/#kitchen etc. with that filter selected
  const fromHash = () => {
    const h = location.hash.slice(1);
    const f = [...filters].find((x) => x.dataset.hash && x.dataset.hash === h);
    if (f) {
      select(f, false);
      // show the filter buttons too, not only the text block the hash points to
      requestAnimationFrame(() => document.querySelector('.filters')?.scrollIntoView({ block: 'start' }));
    }
  };
  fromHash();
  window.addEventListener('hashchange', fromHash);
</script>
