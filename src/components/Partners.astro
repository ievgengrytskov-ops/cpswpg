---
import { Image } from 'astro:assets';
import { partners } from '../data/site';
import { wp } from '../lib/images';
---
<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">We are trusted</span>
        <h2>Partners and <em>customers</em></h2>
      </div>
    </div>
    <ul class="partners reveal">
      {partners.map((p) => (
        <li class:list={{ dark: p.dark }}>
          <Image src={wp(p.image)} alt={p.name} title={p.name} widths={[160, 320]} sizes="160px" format="png" />
        </li>
      ))}
    </ul>
  </div>
</section>
