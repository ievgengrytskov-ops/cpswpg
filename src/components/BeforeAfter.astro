---
// Drag-to-compare before/after photo. Works with mouse, touch and keyboard (native range input).
// Without JS both photos are still in the page (the "before" one is half visible).
import { Image } from 'astro:assets';
import { wp } from '../lib/images';

interface Props {
  before: string;
  after: string;
  beforeAlt: string;
  afterAlt: string;
  sizes?: string;
  class?: string;
}
const { before, after, beforeAlt, afterAlt, sizes = '(max-width: 820px) 100vw, 760px', class: cls } = Astro.props;
const widths = [400, 800, 1200];
---
<figure class:list={['ba', cls]} data-ba>
  <div class="ba-stage">
    <Image src={wp(after)} alt={afterAlt} widths={widths} sizes={sizes} class="ba-img" />
    <div class="ba-before">
      <Image src={wp(before)} alt={beforeAlt} widths={widths} sizes={sizes} class="ba-img" />
    </div>
    <span class="ba-tag ba-tag--before">Before</span>
    <span class="ba-tag ba-tag--after">After</span>
    <span class="ba-line" aria-hidden="true"><span class="ba-knob"></span></span>
    <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="Drag to compare the bathroom before and after" />
  </div>
</figure>

<style>
  .ba { margin: 0; --pos: 50%; }
  .ba-stage { position: relative; aspect-ratio: 4 / 3; overflow: hidden; user-select: none; }
  .ba-stage :global(.ba-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; pointer-events: none; }
  .ba-knob { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; transform: translate(-50%, -50%); border-radius: 50%; background: #fff; box-shadow: 0 2px 12px rgb(0 0 0 / 0.25); }
  .ba-knob::before, .ba-knob::after { content: ''; position: absolute; top: 50%; border: 6px solid transparent; margin-top: -6px; }
  .ba-knob::before { left: 8px; border-right-color: #222; }
  .ba-knob::after { right: 8px; border-left-color: #222; }
  .ba-tag { position: absolute; bottom: 12px; padding: 0.25rem 0.6rem; font: 600 0.75rem/1.2 system-ui, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; background: rgb(0 0 0 / 0.55); pointer-events: none; }
  .ba-tag--before { left: 12px; }
  .ba-tag--after { right: 12px; }
  .ba-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba-stage:has(.ba-range:focus-visible) .ba-knob { outline: 3px solid #fff; outline-offset: 3px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((fig) => {
    const range = fig.querySelector<HTMLInputElement>('.ba-range')!;
    const set = () => fig.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
