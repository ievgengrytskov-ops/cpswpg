---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import emblem from '../assets/brand/emblem.png';
import Messengers from './Messengers.astro';
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
const phone = site.phones[0];
---
<header class="hdr" id="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Image src={emblem} alt="" widths={[56, 112]} sizes="56px" loading="eager" format="webp" />
      <span class="brand-name">Canadian Prime Solutions<small>Natural porcelain tile · Winnipeg</small></span>
    </a>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {nav.map((i) =>
          i.children ? (
            <li class="has-sub">
              <a href={i.children[0].href} class="sub-toggle" aria-haspopup="true">{i.label}</a>
              <ul class="sub">
                {i.children.map((c) => <li><a href={c.href} aria-current={current(c.href)}>{c.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li><a href={i.href} aria-current={current(i.href!)}>{i.label}</a></li>
          )
        )}
      </ul>
    </nav>
    <div class="hdr-cta">
      <a class="hdr-tel" href={phone.href}>{phone.label}</a>
      <a class="btn" href="#contacts">Get a quote</a>
      <button class="theme-btn" type="button" aria-label="Switch to light theme" title="Light / dark theme">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/></svg>
      </button>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
  </div>
</header>
<div class="callbar">
  <a href={phone.href}>Call</a>
  <Messengers variant="icon" />
  <a href="#contacts">Get a quote</a>
</div>
<script>
  const hdr = document.getElementById('hdr')!;
  const btn = hdr.querySelector<HTMLButtonElement>('.menu-btn')!;
  const set = (open: boolean) => {
    hdr.toggleAttribute('data-open', open);
    btn.setAttribute('aria-expanded', String(open));
  };
  btn.addEventListener('click', () => set(!hdr.hasAttribute('data-open')));
  hdr.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => set(false)));

  // Light / dark theme toggle (initial theme is set inline in <head>)
  const themeBtn = hdr.querySelector<HTMLButtonElement>('.theme-btn')!;
  const meta = document.querySelector<HTMLMetaElement>('meta[name=theme-color]');
  const syncLabel = () => {
    const light = document.documentElement.dataset.theme === 'light';
    themeBtn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
    if (meta) meta.content = light ? '#f7f3ee' : '#151413';
  };
  syncLabel();
  themeBtn.addEventListener('click', () => {
    const light = document.documentElement.dataset.theme !== 'light';
    if (light) document.documentElement.dataset.theme = 'light';
    else delete document.documentElement.dataset.theme;
    try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch {}
    syncLabel();
  });

  // Reveal sections on scroll. Content is visible without JS; .js is set in <head>.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
    { rootMargin: '0px 0px -8% 0px' }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
