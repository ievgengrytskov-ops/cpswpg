---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { guides } from '../../lib/guides';
import { wp } from '../../lib/images';
---
<Base
  title="Tub Surround & Porcelain Tile Guides | Canadian Prime Solutions"
  description="Practical guides from a Winnipeg tile team: choosing tile sizes, tiling over old tile, porcelain vs acrylic, and cleaning a porcelain surround."
  image="cps/38.jpg"
  crumb="Guides"
>
  <div class="wrap page-head">
    <span class="eyebrow">Guides</span>
    <h1>Before you <em>renovate</em></h1>
    <p>Straight answers to the questions homeowners ask us most, from the team that installs large porcelain tile in Winnipeg.</p>
  </div>
  <div class="wrap" style="padding-bottom:4rem">
    <div class="guide-list guide-list--index">
      {guides.map((g, i) => (
        <a class="guide-tile" href={`/guides/${g.id}/`}>
          <Image src={wp(g.data.image)} alt="" widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 600px" loading={i < 2 ? 'eager' : 'lazy'} />
          <span class="guide-tile-body"><b>{g.data.title}</b><span>{g.data.lead}</span></span>
        </a>
      ))}
    </div>
  </div>
</Base>
