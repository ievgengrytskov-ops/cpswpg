---
import '@fontsource-variable/figtree';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Analytics from '@vercel/analytics/astro'; // cookieless page views, enabled in Vercel → Analytics
import { getImage } from 'astro:assets';
import { site, navLinks, fullAddress, showroom, showroomFullAddress } from '../data/site';
import { wp } from '../lib/images';
import emblem from '../assets/brand/emblem.png';

interface Props {
  title?: string;
  description?: string;
  /** Share image (Open Graph), path inside src/assets/wp, e.g. '2022/12/10.jpg'. Cropped to 1200x630. */
  image?: string;
  /** Breadcrumb label; defaults to the matching nav label */
  crumb?: string;
  /** Show the contact section before the footer */
  contact?: boolean;
  noindex?: boolean;
  /** Questions shown on the page; added to JSON-LD as FAQPage */
  faq?: { q: string; a: string }[];
  /** Extra JSON-LD nodes (e.g. Service) */
  schema?: Record<string, unknown>[];
}
const {
  title = site.title,
  description = site.description,
  image: imagePath = site.ogImage,
  contact = true,
  noindex = false,
  faq = [],
  schema = [],
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const og = await getImage({ src: wp(imagePath), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const image = new URL(og.src, site.url).href;
const logo = await getImage({ src: emblem, width: 600, format: 'png' });
const crumb = Astro.props.crumb ?? navLinks.find((n) => n.href === path)?.label;
const gaId = import.meta.env.PUBLIC_GA_ID ?? '';

const businessId = `${site.url}/#business`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'HomeAndConstructionBusiness',
    '@id': businessId,
    name: site.name,
    alternateName: site.shortName,
    url: `${site.url}/`,
    logo: new URL(logo.src, site.url).href,
    image,
    description: site.description,
    telephone: site.phones.map((p) => p.href.replace('tel:', '')),
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postal,
      addressCountry: site.address.country,
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    hasMap: site.mapUrl,
    openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: site.hours.days, opens: site.hours.opens, closes: site.hours.closes },
    areaServed: { '@type': 'City', name: site.areaServed },
    sameAs: site.socials.map((s) => s.href),
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.shortName,
    inLanguage: 'en-CA',
    publisher: { '@id': businessId },
  },
];
if (path !== '/' && crumb) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
    ],
  });
}
if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
graph.push(...schema);
const ld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#151413" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="geo.region" content="CA-MB" />
    <meta name="geo.placename" content={site.address.city} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cps_wpg" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    {contact && <Contact />}
    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <h2>{site.name}</h2>
            <p>Large-format natural porcelain tile: showroom, sales and installation. Serving {site.facts.serviceArea}.</p>
            <p>Showroom: <a href={showroom.mapUrl} rel="noopener" target="_blank">{showroomFullAddress}</a>, {showroom.hours}</p>
            <p class="foot-legal">Tile sales and showroom: {showroom.name} ({showroom.legalName}), a subsidiary of Canadian Prime Solutions Inc.</p>
          </div>
          <div>
            <h2>Explore</h2>
            <ul>
              {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2>Contact</h2>
            <ul>
              {site.phones.map((p) => <li><a class="foot-big" href={p.href}>{p.label}</a></li>)}
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={site.mapUrl} rel="noopener" target="_blank">{fullAddress}</a></li>
              <li>Office: {site.hours.text}</li>
            </ul>
          </div>
          <div>
            <h2>Follow</h2>
            <ul>
              {site.socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <p>© {new Date().getFullYear()} {site.name}</p>
          <p><a href="/privacy-policy/">Privacy Policy</a></p>
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
